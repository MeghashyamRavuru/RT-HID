[Unit]
Description=RT-HID standalone host intrusion detection agent
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/opt/rt-hid
ExecStart=/opt/rt-hid/.venv/bin/python -m rt_hid.host.cli --config /etc/rt-hid/host_ids.json dashboard
Restart=on-failure
RestartSec=5
# Add narrowly scoped read permissions for auth logs and protected files as needed.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
